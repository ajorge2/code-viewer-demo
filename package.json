{
  "name": "code-viewer-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visible code chunking — point it at a codebase, see how it chunks, tune chunk size live. Phase 1 of a code-architecture understanding tool.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --import braintrust/hook.mjs --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm install --prefix client --include=dev && npm --prefix client run build",
    "start": "node --import braintrust/hook.mjs server/index.js",
    "test": "node --test",
    "intent:pilot": "node experiments/intent-algebra/run-pilot.js",
    "intent:pilot:additive": "node experiments/intent-algebra/run-pilot.js --output .data/intent-pilot-additive --addition-dominant --min-added-nodes 2 --max-removal-ratio 0.25",
    "intent:mine": ".tools/submine-venv/bin/python experiments/intent-algebra/mine-graphs.py",
    "intent:mine:additive": ".tools/submine-venv/bin/python experiments/intent-algebra/mine-graphs.py --data .data/intent-pilot-additive/eligible-change-graphs.data --labels .data/intent-pilot-additive/gspan-labels.json --graph-index .data/intent-pilot-additive/graph-index.json --output .data/intent-pilot-additive/mined-patterns.json --min-support 5 --min-vertices 3 --max-vertices 10",
    "intent:grounding-queue": "node experiments/intent-algebra/build-grounding-queue.js",
    "intent:grounding-queue:additive": "node experiments/intent-algebra/build-grounding-queue.js --pilot-root .data/intent-pilot-additive",
    "intent:facets:additive": "node experiments/intent-algebra/extract-facets.js --pilot-root .data/intent-pilot-additive",
    "intent:cluster:additive": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/cluster-concepts.py",
    "intent:cluster:embeddings:additive": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/cluster-embedding-concepts.py",
    "intent:plots": "python3 experiments/intent-algebra/plot-pilot.py",
    "intent:plots:additive": "python3 experiments/intent-algebra/plot-pilot.py --input .data/intent-pilot-additive --output docs/figures/intent-algebra-additive",
    "intent:sweep:additive": "node experiments/intent-algebra/run-pilot.js --output .data/intent-sweep-additive-500 --per-language 500 --addition-dominant --min-added-nodes 2 --max-removal-ratio 0.25",
    "intent:sweep:mine": ".tools/submine-venv/bin/python experiments/intent-algebra/mine-graphs.py --data .data/intent-sweep-additive-500/eligible-change-graphs.data --labels .data/intent-sweep-additive-500/gspan-labels.json --graph-index .data/intent-sweep-additive-500/graph-index.json --output .data/intent-sweep-additive-500/mined-patterns.json --min-support 15 --min-vertices 3 --max-vertices 6",
    "intent:sweep:facets": "node experiments/intent-algebra/extract-facets.js --pilot-root .data/intent-sweep-additive-500",
    "intent:sweep:grounding-queue": "node experiments/intent-algebra/build-grounding-queue.js --pilot-root .data/intent-sweep-additive-500",
    "intent:sweep:cluster": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/cluster-embedding-concepts.py --input .data/intent-sweep-additive-500/edit-facets.jsonl --samples .data/intent-sweep-additive-500/sample-results.jsonl --output .data/intent-sweep-additive-500/embedding-concept-clusters.json --cache .data/intent-sweep-additive-500/openai-embedding-cache.json --figure docs/figures/intent-algebra-sweep-500/embedding-concept-clusters.svg --batch-size 128 --distance-threshold 0.30 --parent-distance-threshold 0.20 --max-hierarchy-levels 3",
    "intent:sweep:plots": "python3 experiments/intent-algebra/plot-pilot.py --input .data/intent-sweep-additive-500 --output docs/figures/intent-algebra-sweep-500",
    "intent:scale:additive": "node experiments/intent-algebra/run-pilot.js --output .data/intent-sweep-additive-2000 --per-language 2000 --addition-dominant --min-added-nodes 2 --max-removal-ratio 0.25",
    "intent:scale:mine": ".tools/submine-venv/bin/python experiments/intent-algebra/mine-graphs.py --data .data/intent-sweep-additive-2000/eligible-change-graphs.data --labels .data/intent-sweep-additive-2000/gspan-labels.json --graph-index .data/intent-sweep-additive-2000/graph-index.json --output .data/intent-sweep-additive-2000/mined-patterns.json --min-support 50 --min-vertices 3 --max-vertices 6",
    "intent:scale:facets": "node experiments/intent-algebra/extract-facets.js --pilot-root .data/intent-sweep-additive-2000",
    "intent:scale:grounding-queue": "node experiments/intent-algebra/build-grounding-queue.js --pilot-root .data/intent-sweep-additive-2000",
    "intent:scale:cluster": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/cluster-embedding-concepts.py --input .data/intent-sweep-additive-2000/edit-facets.jsonl --samples .data/intent-sweep-additive-2000/sample-results.jsonl --output .data/intent-sweep-additive-2000/embedding-concept-clusters.json --cache .data/intent-sweep-additive-2000/openai-embedding-cache.json --figure docs/figures/intent-algebra-sweep-2000/embedding-concept-clusters.svg --batch-size 128 --distance-threshold 0.30 --parent-distance-threshold 0.20 --max-hierarchy-levels 3",
    "intent:scale:stability": "python3 experiments/intent-algebra/compare-cluster-stability.py --old .data/intent-sweep-additive-500/embedding-concept-clusters.json --new .data/intent-sweep-additive-2000/embedding-concept-clusters.json --output .data/intent-sweep-additive-2000/cluster-stability.json --markdown .data/intent-sweep-additive-2000/cluster-stability.md --figure docs/figures/intent-algebra-sweep-2000/cluster-stability.svg",
    "intent:scale:expansion-pool": "node experiments/intent-algebra/build-expansion-pool.js --pilot-root .data/intent-sweep-additive-2000",
    "intent:scale:expand": ".tools/submine-venv/bin/python experiments/intent-algebra/expand-base-coedits.py --patterns .data/intent-sweep-additive-2000/mined-patterns.json --graph-index .data/intent-sweep-additive-2000/graph-index.json --samples .data/intent-sweep-additive-2000/sample-results.jsonl --output .data/intent-sweep-additive-2000/base-coedit-expansions.json --retrieval constraint --coedit-unit bundle --similarity-threshold 0.75 --min-support 5",
    "intent:scale:expand-within": ".tools/submine-venv/bin/python experiments/intent-algebra/expand-base-coedits.py --patterns .data/intent-sweep-additive-2000/mined-patterns.json --graph-index .data/intent-sweep-additive-2000/graph-index.json --samples .data/intent-sweep-additive-2000/sample-results.jsonl --output .data/intent-sweep-additive-2000/base-within-component-expansions.json --retrieval host-set --context-source within-component --coedit-unit bundle --similarity-threshold 0.75 --min-support 5",
    "intent:scale:expand-combined": ".tools/submine-venv/bin/python experiments/intent-algebra/expand-base-coedits.py --patterns .data/intent-sweep-additive-2000/mined-patterns.json --graph-index .data/intent-sweep-additive-2000/graph-index.json --samples .data/intent-sweep-additive-2000/sample-results.jsonl --output .data/intent-sweep-additive-2000/base-combined-expansions.json --retrieval constraint --context-source combined --coedit-unit bundle --similarity-threshold 0.75 --min-support 5",
    "intent:scale:align": "python3 experiments/intent-algebra/align-semantic-structural.py --semantic-clusters .data/intent-sweep-additive-2000/embedding-concept-clusters.json --bases .data/intent-sweep-additive-2000/mined-patterns.json --composites .data/intent-sweep-additive-2000/base-within-component-expansions.json --output .data/intent-sweep-additive-2000/semantic-structural-alignment.json --min-overlap 2 --max-clauses 6 --max-recursive-proposals 8",
    "intent:scale:refine-semantics": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/refine-semantic-clusters.py --clusters .data/intent-sweep-additive-2000/embedding-concept-clusters.json --facets .data/intent-sweep-additive-2000/edit-facets.jsonl --samples .data/intent-sweep-additive-2000/sample-results.jsonl --embedding-cache .data/intent-sweep-additive-2000/openai-embedding-cache.json --bases .data/intent-sweep-additive-2000/mined-patterns.json --composites .data/intent-sweep-additive-2000/base-within-component-expansions.json --output .data/intent-sweep-additive-2000/recursive-semantic-refinement.json",
    "intent:scale:ground-meanings": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/ground-semantic-meanings.py --refinement .data/intent-sweep-additive-2000/recursive-semantic-refinement.json --facets .data/intent-sweep-additive-2000/edit-facets.jsonl --samples .data/intent-sweep-additive-2000/sample-results.jsonl --embedding-cache .data/intent-sweep-additive-2000/openai-embedding-cache.json --hypothesis-cache .data/intent-sweep-additive-2000/meaning-hypothesis-cache.json --meaning-embedding-cache .data/intent-sweep-additive-2000/meaning-embedding-cache.json --output .data/intent-sweep-additive-2000/grounded-semantic-meanings.json --minimum-support 6 --batch-size 5",
    "intent:scale:plots": "python3 experiments/intent-algebra/plot-pilot.py --input .data/intent-sweep-additive-2000 --output docs/figures/intent-algebra-sweep-2000",
    "intent:large:additive": "node experiments/intent-algebra/run-pilot.js --output .data/intent-sweep-additive-5000 --per-language 5000 --addition-dominant --min-added-nodes 2 --max-removal-ratio 0.25",
    "intent:large:facets": "node experiments/intent-algebra/extract-facets.js --pilot-root .data/intent-sweep-additive-5000",
    "intent:large:cluster": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/cluster-embedding-concepts.py --input .data/intent-sweep-additive-5000/edit-facets.jsonl --samples .data/intent-sweep-additive-5000/sample-results.jsonl --output .data/intent-sweep-additive-5000/embedding-concept-clusters.json --cache .data/intent-sweep-additive-5000/openai-embedding-cache.json --figure docs/figures/intent-algebra-sweep-5000/embedding-concept-clusters.svg --batch-size 128 --distance-threshold 0.30 --parent-distance-threshold 0.20 --max-hierarchy-levels 3",
    "intent:large:stability": "python3 experiments/intent-algebra/compare-cluster-stability.py --old .data/intent-sweep-additive-2000/embedding-concept-clusters.json --new .data/intent-sweep-additive-5000/embedding-concept-clusters.json --output .data/intent-sweep-additive-5000/cluster-stability.json --markdown .data/intent-sweep-additive-5000/cluster-stability.md --figure docs/figures/intent-algebra-sweep-5000/cluster-stability.svg",
    "intent:large:refine-semantics": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/refine-semantic-clusters.py --clusters .data/intent-sweep-additive-5000/embedding-concept-clusters.json --facets .data/intent-sweep-additive-5000/edit-facets.jsonl --samples .data/intent-sweep-additive-5000/sample-results.jsonl --embedding-cache .data/intent-sweep-additive-5000/openai-embedding-cache.json --bases .data/intent-sweep-additive-2000/mined-patterns.json --composites .data/intent-sweep-additive-2000/base-within-component-expansions.json --output .data/intent-sweep-additive-5000/recursive-semantic-refinement.json",
    "intent:large:ground-meanings": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/ground-semantic-meanings.py --refinement .data/intent-sweep-additive-5000/recursive-semantic-refinement.json --facets .data/intent-sweep-additive-5000/edit-facets.jsonl --samples .data/intent-sweep-additive-5000/sample-results.jsonl --embedding-cache .data/intent-sweep-additive-5000/openai-embedding-cache.json --hypothesis-cache .data/intent-sweep-additive-5000/meaning-hypothesis-cache.json --meaning-embedding-cache .data/intent-sweep-additive-5000/meaning-embedding-cache.json --output .data/intent-sweep-additive-5000/grounded-semantic-meanings.json --minimum-support 6 --batch-size 5",
    "intent:large:induce-structure:invariant": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/induce-category-structural-rules.py --meanings .data/intent-sweep-additive-5000/grounded-semantic-meanings.json --refinement .data/intent-sweep-additive-5000/recursive-semantic-refinement.json --samples .data/intent-sweep-additive-5000/sample-results.jsonl --output .data/intent-sweep-additive-5000/category-structural-rules-invariant.json",
    "intent:large:induce-structure:anchors": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/induce-category-structural-rules.py --meanings .data/intent-sweep-additive-5000/grounded-semantic-meanings.json --refinement .data/intent-sweep-additive-5000/recursive-semantic-refinement.json --samples .data/intent-sweep-additive-5000/sample-results.jsonl --output .data/intent-sweep-additive-5000/category-structural-rules-anchors.json --allow-code-anchors",
    "intent:large:induce-structure": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/induce-category-structural-rules.py --meanings .data/intent-sweep-additive-5000/grounded-semantic-meanings.json --refinement .data/intent-sweep-additive-5000/recursive-semantic-refinement.json --samples .data/intent-sweep-additive-5000/sample-results.jsonl --output .data/intent-sweep-additive-5000/category-structural-rules.json --allow-code-anchors --allow-context-frames --require-structural-atom",
    "intent:large:materialize-pairs": "node experiments/intent-algebra/materialize-paired-corpus.js --samples .data/intent-sweep-additive-5000/sample-results.jsonl --data-root .data/commitpackft/data --output .data/intent-sweep-additive-5000/paired-corpus",
    "intent:large:semgrep-before": "env XDG_CONFIG_HOME=.tools/semgrep/config XDG_CACHE_HOME=.tools/semgrep/cache SSL_CERT_FILE=/etc/ssl/cert.pem SEMGREP_ENABLE_VERSION_CHECK=0 SEMGREP_SEND_METRICS=off pysemgrep --no-git-ignore --config experiments/intent-algebra/paired-semgrep-rules.yml --json --output .data/intent-sweep-additive-5000/semgrep-before.json .data/intent-sweep-additive-5000/paired-corpus/before/python",
    "intent:large:semgrep-after": "env XDG_CONFIG_HOME=.tools/semgrep/config XDG_CACHE_HOME=.tools/semgrep/cache SSL_CERT_FILE=/etc/ssl/cert.pem SEMGREP_ENABLE_VERSION_CHECK=0 SEMGREP_SEND_METRICS=off pysemgrep --no-git-ignore --config experiments/intent-algebra/paired-semgrep-rules.yml --json --output .data/intent-sweep-additive-5000/semgrep-after.json .data/intent-sweep-additive-5000/paired-corpus/after/python",
    "intent:large:evaluate-semgrep": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/evaluate-paired-semgrep.py --before-results .data/intent-sweep-additive-5000/semgrep-before.json --after-results .data/intent-sweep-additive-5000/semgrep-after.json --manifest .data/intent-sweep-additive-5000/paired-corpus/manifest.json --samples .data/intent-sweep-additive-5000/sample-results.jsonl --refinement .data/intent-sweep-additive-5000/recursive-semantic-refinement.json --rules .data/intent-sweep-additive-5000/category-structural-rules.json --output .data/intent-sweep-additive-5000/paired-semgrep-evaluation.json",
    "intent:large:audit-expansions": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/audit-semantic-expansions.py --evaluation .data/intent-sweep-additive-5000/paired-semgrep-evaluation.json --meanings .data/intent-sweep-additive-5000/grounded-semantic-meanings.json --refinement .data/intent-sweep-additive-5000/recursive-semantic-refinement.json --facets .data/intent-sweep-additive-5000/edit-facets.jsonl --samples .data/intent-sweep-additive-5000/sample-results.jsonl --embedding-cache .data/intent-sweep-additive-5000/openai-embedding-cache.json --meaning-embedding-cache .data/intent-sweep-additive-5000/meaning-embedding-cache.json --audit-cache .data/intent-sweep-additive-5000/semantic-expansion-audit-cache.json --output .data/intent-sweep-additive-5000/semantic-expansion-audit.json",
    "intent:large:induce-structure:expanded": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/induce-category-structural-rules.py --meanings .data/intent-sweep-additive-5000/grounded-semantic-meanings.json --refinement .data/intent-sweep-additive-5000/recursive-semantic-refinement.json --samples .data/intent-sweep-additive-5000/sample-results.jsonl --semantic-expansions .data/intent-sweep-additive-5000/semantic-expansion-audit.json --output .data/intent-sweep-additive-5000/category-structural-rules-expanded.json --allow-code-anchors --allow-context-frames --require-structural-atom",
    "intent:large:evaluate-semgrep:expanded": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/evaluate-paired-semgrep.py --before-results .data/intent-sweep-additive-5000/semgrep-before.json --after-results .data/intent-sweep-additive-5000/semgrep-after.json --manifest .data/intent-sweep-additive-5000/paired-corpus/manifest.json --samples .data/intent-sweep-additive-5000/sample-results.jsonl --refinement .data/intent-sweep-additive-5000/recursive-semantic-refinement.json --semantic-expansions .data/intent-sweep-additive-5000/semantic-expansion-audit.json --rules .data/intent-sweep-additive-5000/category-structural-rules-expanded.json --output .data/intent-sweep-additive-5000/paired-semgrep-evaluation-expanded.json",
    "intent:large:provenance": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/analyze-repository-independence.py --rules .data/intent-sweep-additive-5000/category-structural-rules-expanded.json --refinement .data/intent-sweep-additive-5000/recursive-semantic-refinement.json --samples .data/intent-sweep-additive-5000/sample-results.jsonl --semantic-expansions .data/intent-sweep-additive-5000/semantic-expansion-audit.json --output .data/intent-sweep-additive-5000/repository-independence.json",
    "intent:large:structural-mdl": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/evaluate-structural-mdl.py --rules .data/intent-sweep-additive-5000/category-structural-rules-expanded.json --samples .data/intent-sweep-additive-5000/sample-results.jsonl --output .data/intent-sweep-additive-5000/structural-mdl.json --minimum-ratio 1.2",
    "intent:large:probe-rules": ".tools/concept-cluster-venv/bin/python experiments/intent-algebra/probe-structural-rules.py --rules .data/intent-sweep-additive-5000/category-structural-rules-expanded.json --samples .data/intent-sweep-additive-5000/sample-results.jsonl --output .data/intent-sweep-additive-5000/structural-rule-probes.json",
    "intent:large:plots": "python3 experiments/intent-algebra/plot-pilot.py --input .data/intent-sweep-additive-5000 --output docs/figures/intent-algebra-sweep-5000",
    "intent:review": "node experiments/intent-algebra/review-server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "braintrust": "3.29.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
