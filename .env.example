# Required only for the chat / Q&A, "suggest edits", and folder-summary features.
# Chunking and the file viewer work without it.
OPENAI_API_KEY=

# Optional: send LLM traces, token usage, latency, and cost to Braintrust.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_NAME=CodeArchitect

# Codebase to inspect. Defaults to this repo (so the app self-demoes).
# PROJECT_DIR=/path/to/a/repo

# API port (the Vite client proxies /api here). Defaults to 8799.
# PORT=8799

# Model overrides (optional). Defaults: GPT-5.1 for answers/context and GPT-5 mini
# for the many small per-node "bare" meaning passes.
# ANSWER_MODEL=gpt-5.1
# MEANING_MODEL=gpt-5.1
# BARE_MODEL=gpt-5-mini

# Optional: eagerly summarize every file and folder when a project loads.
# Off by default; existing summaries persist and cache misses are computed lazily.
# EAGER_PROJECT_WARM=1
