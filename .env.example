# Required only for the chat / Q&A, "suggest edits", and folder-summary features.
# Chunking and the file viewer work without it.
ANTHROPIC_API_KEY=

# Codebase to inspect. Defaults to this repo (so the app self-demoes).
# PROJECT_DIR=/path/to/a/repo

# API port (the Vite client proxies /api here). Defaults to 8799.
# PORT=8799

# Model overrides (optional). Defaults: opus for answers/context, haiku for the
# many small per-node "bare" meaning passes (set MEANING_MODEL=claude-haiku-4-5
# to cut cost further).
# ANSWER_MODEL=claude-opus-4-8
# MEANING_MODEL=claude-opus-4-8
# BARE_MODEL=claude-haiku-4-5
